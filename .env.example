# ── DATABASE (PostgreSQL) ─────────────────────────────
# Local:    postgresql://user:pass@localhost:5432/papero?schema=public
# Vercel:   Neon / Supabase / Vercel Postgres pooled connection string
#           (use the "pooled" URL with ?pgbouncer=true&connection_limit=1)
DATABASE_URL="postgresql://papero_user:Papero@2024@localhost:5432/papero?schema=public"

# ── AUTH (NextAuth) ───────────────────────────────────
# Vercel pe ye apne deployed URL pe set karo, e.g. https://papero.vercel.app
NEXTAUTH_URL="http://localhost:3000"
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-key-here"

# ── AI (Google Gemini) ────────────────────────────────
# https://aistudio.google.com/apikey
GEMINI_API_KEY="your-gemini-api-key-here"

# ── CACHE (Redis) ─────────────────────────────────────
# Upstash Redis recommended for Vercel (serverless-friendly, TLS):
# redis://default:<password>@<host>.upstash.io:6379
REDIS_URL="redis://default:password@your-redis-url.com:6379"

# ── THIRD PARTY API KEYS ──────────────────────────────
PUBMED_API_KEY=""
